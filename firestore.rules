rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function group(id) {
      return get(/databases/$(database)/documents/sharedGroups/$(id)).data;
    }
    function owns(id) { return signedIn() && group(id).adminUid == request.auth.uid; }
    function membershipId(groupId) { return request.auth.uid + '_' + groupId; }
    function participantActive(groupId, personId) {
      let record = group(groupId);
      let snapshot = record.snapshot;
      return (!('deleted' in record) || record.deleted != true) &&
        (!('activeMemberIds' in snapshot) || personId in snapshot.activeMemberIds);
    }
    function participantAccess(groupId) {
      let path = /databases/$(database)/documents/groupMemberships/$(membershipId(groupId));
      return exists(path) && participantActive(groupId, get(path).data.personId) &&
        get(/databases/$(database)/documents/groupInvites/$(get(path).data.inviteId)).data.status == 'accepted';
    }
    match /users/{uid}/finance/{recordId} {
      function owner() { return signedIn() && request.auth.uid == uid; }
      function stateAfter() {
        return getAfter(/databases/$(database)/documents/users/$(uid)/finance/state).data;
      }
      function validState() {
        let next = request.resource.data;
        return next.keys().hasOnly(['schemaVersion', 'revision', 'recordCount', 'orders', 'updatedAt']) &&
          next.schemaVersion == 2 && next.revision is int && next.recordCount is int && next.orders is map &&
          next.recordCount >= 1 && next.recordCount <= 10000 && next.updatedAt == request.time;
      }
      function validRecord() {
        let next = request.resource.data;
        let state = stateAfter();
        return recordId.matches('(people|groups|expenses|goals|contributions|settlements|income|plans):.*') &&
          next.keys().hasOnly(['kind', 'key', 'payload', 'revision']) && next.key is string &&
          next.kind in ['people', 'groups', 'expenses', 'goals', 'contributions', 'settlements', 'income', 'plans'] &&
          next.payload is string && next.payload.size() <= 750000 && next.revision == state.revision;
      }
      allow read: if owner();
      allow create: if owner() && ((recordId == 'state' && validState() && request.resource.data.revision == 1) ||
        (recordId != 'state' && validRecord()));
      allow update: if owner() && ((recordId == 'state' && validState() &&
        request.resource.data.revision == resource.data.revision + 1) ||
        (recordId != 'state' && validRecord() && request.resource.data.revision > resource.data.revision));
      allow delete: if owner() && recordId != 'state' &&
        stateAfter().revision > resource.data.revision;
    }
    match /sharedGroups/{id} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/sharedGroups/$(id)) &&
        id.matches(request.auth.uid + '_.*');
      allow read: if signedIn() && (resource.data.adminUid == request.auth.uid ||
        participantAccess(id));
      allow create: if signedIn() && request.resource.data.adminUid == request.auth.uid &&
        id == request.auth.uid + '_' + request.resource.data.snapshot.id &&
        request.resource.data.keys().hasOnly(['adminUid', 'snapshot', 'revision', 'updatedAt', 'deleted']) &&
        (!('deleted' in request.resource.data) || request.resource.data.deleted is bool) &&
        request.resource.data.revision == 1 && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.adminUid == request.auth.uid &&
        request.resource.data.adminUid == resource.data.adminUid &&
        request.resource.data.snapshot.id == resource.data.snapshot.id &&
        request.resource.data.keys().hasOnly(['adminUid', 'snapshot', 'revision', 'updatedAt', 'deleted']) &&
        (!('deleted' in request.resource.data) || request.resource.data.deleted is bool) &&
        (!('deleted' in resource.data) || resource.data.deleted != true || request.resource.data.deleted == true) &&
        request.resource.data.revision == resource.data.revision + 1 &&
        request.resource.data.updatedAt == request.time;
    }
    match /groupInvites/{id} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/groupInvites/$(id)) &&
        id.matches(request.auth.uid + '_.*');
      allow read: if signedIn() && (resource.data.adminUid == request.auth.uid ||
        (verifiedEmail() && resource.data.email == request.auth.token.email.lower()));
      function pendingInvite() {
        let next = request.resource.data;
        return next.keys().hasOnly(['groupId', 'personId', 'email', 'personName',
          'groupName', 'adminUid', 'status', 'updatedAt']) &&
          next.adminUid == request.auth.uid && owns(next.groupId) && participantActive(next.groupId, next.personId) &&
          id == next.groupId + '_' + next.personId &&
          next.status == 'pending' && next.email is string &&
          next.email == next.email.lower() && next.email.size() <= 254 &&
          next.updatedAt == request.time;
      }
      allow create: if signedIn() && pendingInvite();
      allow delete: if signedIn() && resource.data.adminUid == request.auth.uid &&
        (resource.data.status == 'pending' || (('deleted' in group(resource.data.groupId)) && group(resource.data.groupId).deleted == true));
      allow update: if signedIn() && (
        (resource.data.adminUid == request.auth.uid && owns(resource.data.groupId) &&
          (resource.data.status == 'accepted' || (resource.data.status == 'pending' && ('deleted' in group(resource.data.groupId)) && group(resource.data.groupId).deleted == true)) &&
          request.resource.data.status == 'revoked' && request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (resource.data.status in ['pending', 'revoked'] &&
          resource.data.adminUid == request.auth.uid && pendingInvite() &&
          request.resource.data.groupId == resource.data.groupId && request.resource.data.personId == resource.data.personId) ||
        (resource.data.status == 'pending' &&
        (verifiedEmail() && resource.data.email == request.auth.token.email.lower() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedUid']) &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.acceptedUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/groupMemberships/$(membershipId(resource.data.groupId))).data.inviteId == id)));
    }
    match /groupMemberships/{id} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/groupMemberships/$(id)) &&
        id.matches(request.auth.uid + '_.*');
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || owns(resource.data.groupId));
      allow delete: if signedIn() && owns(resource.data.groupId) &&
        ((('deleted' in group(resource.data.groupId)) && group(resource.data.groupId).deleted == true) ||
          (getAfter(/databases/$(database)/documents/groupInvites/$(resource.data.inviteId)).data.status == 'revoked' &&
          getAfter(/databases/$(database)/documents/groupInvites/$(resource.data.inviteId)).data.acceptedUid == resource.data.uid));
      allow create: if verifiedEmail() &&
        request.resource.data.keys().hasOnly(['uid', 'groupId', 'personId', 'inviteId']) &&
        request.resource.data.uid == request.auth.uid &&
        id == membershipId(request.resource.data.groupId) && validAcceptance();
      function validAcceptance() {
        let next = request.resource.data;
        let invite = get(/databases/$(database)/documents/groupInvites/$(next.inviteId)).data;
        let accepted = getAfter(/databases/$(database)/documents/groupInvites/$(next.inviteId)).data;
        return invite.status == 'pending' && invite.email == request.auth.token.email.lower() && participantActive(next.groupId, next.personId) &&
          invite.groupId == next.groupId && invite.personId == next.personId &&
          accepted.status == 'accepted' && accepted.acceptedUid == request.auth.uid;
      }
    }
  }
}
