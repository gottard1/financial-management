# Configuração pública do app Web no Firebase Console.
# Copie este arquivo para .env.local e reinicie npm run dev após preencher.
# Em produção, configure estas variáveis no ambiente de hospedagem e gere um novo build.
# Os quatro primeiros campos são obrigatórios para habilitar o login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Campos opcionais do mesmo aplicativo Web.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Ative E-mail/senha e Google no Firebase Authentication.
# Cadastre localhost e os domínios usados pelo app em Authentication > Settings > Authorized domains.
# A API key Web identifica o projeto; não é uma credencial Admin SDK.
# Nunca coloque chaves privadas ou credenciais de serviço em variáveis VITE_.
# Ative somente depois de criar o Cloud Firestore e publicar firestore.rules.
VITE_GROUP_SHARING_ENABLED=false
